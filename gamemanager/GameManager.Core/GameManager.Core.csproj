<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>GameManager.Core</RootNamespace>
    <AssemblyName>GameManager.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- DataContractJsonSerializer (R10): BCL only, no JSON NuGet package in the shipped app. -->
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test seams (GameListBuilder's classifier delegate) stay internal. -->
    <InternalsVisibleTo Include="GameManager.Tests" />
  </ItemGroup>

</Project>
